<!DOCTYPE html>
<html lang="en">
   <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <meta name="color-scheme" content="light" />
      <title>Reset Your Password - Power Pulse</title>

      <style>
         * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
         }

         body {
            margin: 0;
            padding: 0;
            background-color: #f8fafc;
            font-family:
               Inter,
               -apple-system,
               BlinkMacSystemFont,
               "Segoe UI",
               Arial,
               Helvetica,
               sans-serif;
            color: #111827;
         }

         .email-wrapper {
            width: 100%;
            padding: 48px 16px;
            background-color: #f8fafc;
         }

         .email-container {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            overflow: hidden;
         }

         /* Header */

         .header {
            padding: 34px 40px;
            background-color: #4f46e5;
            text-align: center;
         }

         .brand-mark {
            width: 48px;
            height: 48px;
            margin: 0 auto 14px;
            border-radius: 12px;
            background-color: #ffffff;
            color: #4f46e5;
            font-size: 24px;
            font-weight: 800;
            line-height: 48px;
            letter-spacing: -1px;
         }

         .brand-name {
            color: #ffffff;
            font-size: 24px;
            line-height: 1.3;
            font-weight: 700;
            letter-spacing: -0.4px;
         }

         .brand-subtitle {
            margin-top: 7px;
            color: #e0e7ff;
            font-size: 13px;
            line-height: 1.5;
         }

         /* Content */

         .content {
            padding: 42px 44px 40px;
         }

         .greeting {
            margin-bottom: 14px;
            color: #111827;
            font-size: 21px;
            line-height: 1.4;
            font-weight: 700;
         }

         .message {
            margin-bottom: 30px;
            color: #64748b;
            font-size: 15px;
            line-height: 1.75;
         }

         /* Password Reset Badge */

         .reset-badge {
            display: inline-block;
            margin-bottom: 22px;
            padding: 7px 12px;
            background-color: #eef2ff;
            border: 1px solid #e0e7ff;
            border-radius: 20px;
            color: #4338ca;
            font-size: 11px;
            line-height: 1.4;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
         }

         /* OTP */

         .otp-section {
            padding: 28px 20px;
            background-color: #f8f9ff;
            border: 1px solid #e0e7ff;
            border-radius: 12px;
            text-align: center;
         }

         .otp-label {
            margin-bottom: 13px;
            color: #64748b;
            font-size: 12px;
            line-height: 1.4;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.4px;
         }

         .otp {
            display: inline-block;
            min-width: 210px;
            padding: 13px 24px;
            background-color: #ffffff;
            border: 1px solid #c7d2fe;
            border-radius: 10px;
            color: #4f46e5;
            font-size: 32px;
            line-height: 1.3;
            font-weight: 800;
            letter-spacing: 8px;
            font-family: "Courier New", monospace;
         }

         .expiration {
            margin-top: 14px;
            color: #94a3b8;
            font-size: 12px;
            line-height: 1.6;
         }

         .expiration strong {
            color: #4f46e5;
            font-weight: 700;
         }

         /* Instructions */

         .instructions {
            margin-top: 26px;
         }

         .instructions-title {
            margin-bottom: 10px;
            color: #334155;
            font-size: 14px;
            line-height: 1.5;
            font-weight: 700;
         }

         .instruction-item {
            margin-bottom: 9px;
            color: #64748b;
            font-size: 13px;
            line-height: 1.7;
         }

         .instruction-number {
            color: #4f46e5;
            font-weight: 700;
         }

         /* Security Notice */

         .security-box {
            margin-top: 28px;
            padding: 17px 18px;
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-left: 4px solid #4f46e5;
            border-radius: 10px;
         }

         .security-title {
            margin-bottom: 6px;
            color: #334155;
            font-size: 13px;
            line-height: 1.5;
            font-weight: 700;
         }

         .security-text {
            color: #64748b;
            font-size: 12px;
            line-height: 1.75;
         }

         /* Footer */

         .footer {
            padding: 24px 30px;
            background-color: #f8fafc;
            border-top: 1px solid #eef2f7;
            text-align: center;
         }

         .footer-text {
            color: #94a3b8;
            font-size: 12px;
            line-height: 1.7;
         }

         .footer-brand {
            margin-top: 9px;
            color: #4f46e5;
            font-size: 13px;
            line-height: 1.5;
            font-weight: 700;
         }

         .footer-caption {
            margin-top: 5px;
            color: #94a3b8;
            font-size: 11px;
            line-height: 1.5;
         }

         /* Mobile */

         @media (max-width: 480px) {
            .email-wrapper {
               padding: 24px 12px;
            }

            .header {
               padding: 30px 22px;
            }

            .content {
               padding: 32px 22px;
            }

            .brand-name {
               font-size: 22px;
            }

            .greeting {
               font-size: 19px;
            }

            .reset-badge {
               font-size: 10px;
            }

            .otp-section {
               padding: 24px 14px;
            }

            .otp {
               min-width: 180px;
               padding: 12px 18px;
               font-size: 27px;
               letter-spacing: 6px;
            }

            .security-box {
               padding: 15px;
            }

            .footer {
               padding: 22px 18px;
            }
         }
      </style>
   </head>

   <body>
      <div class="email-wrapper">
         <div class="email-container">

            <!-- Header -->
            <div class="header">
               <div class="brand-mark">PP</div>

               <div class="brand-name">Power Pulse</div>

               <div class="brand-subtitle">
                  Load Shedding &amp; Power Management
               </div>
            </div>

            <!-- Main Content -->
            <div class="content">
               <div class="reset-badge">
                  Password Reset Request
               </div>

               <div class="greeting">
                  Hello <%= name %>,
               </div>

               <p class="message">
                  We received a request to reset the password associated
                  with your Power Pulse account. To verify your identity
                  and continue resetting your password, please use the
                  one-time verification code below.
               </p>

               <!-- OTP -->
               <div class="otp-section">
                  <div class="otp-label">
                     Password Reset Code
                  </div>

                  <div class="otp"><%= otp %></div>

                  <div class="expiration">
                     This verification code will expire in
                     <strong><%= expirationTime %> minutes</strong>.
                  </div>
               </div>

               <!-- Instructions -->
               <div class="instructions">
                  <div class="instructions-title">
                     What to do next
                  </div>

                  <p class="instruction-item">
                     <span class="instruction-number">01.</span>
                     Enter this verification code on the password reset
                     verification page.
                  </p>

                  <p class="instruction-item">
                     <span class="instruction-number">02.</span>
                     After successful verification, create a new,
                     secure password for your account.
                  </p>
               </div>

               <!-- Security Notice -->
               <div class="security-box">
                  <div class="security-title">
                     Keep your account secure
                  </div>

                  <div class="security-text">
                     Never share this verification code with anyone.
                     Power Pulse will never ask you to share your OTP
                     or password. If you did not request a password
                     reset, ignore this email. Your password will
                     remain unchanged.
                  </div>
               </div>
            </div>

            <!-- Footer -->
            <div class="footer">
               <div class="footer-text">
                  This is an automated security email sent because
                  a password reset was requested for your account.
               </div>

               <div class="footer-brand">
                  Power Pulse
               </div>

               <div class="footer-caption">
                  Load Shedding &amp; Power Management System
               </div>
            </div>

         </div>
      </div>
   </body>
</html>

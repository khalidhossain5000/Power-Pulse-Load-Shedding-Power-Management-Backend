<!DOCTYPE html>

<html lang="en">
   <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Verify Your Email - Power Pulse</title>

      <style>
         * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
         }

         body {
            margin: 0;
            padding: 0;
            background-color: #f8fafc;
            font-family:
               Inter,
               -apple-system,
               BlinkMacSystemFont,
               "Segoe UI",
               Arial,
               Helvetica,
               sans-serif;
            color: #111827;
         }

         .email-wrapper {
            width: 100%;
            padding: 48px 16px;
            background-color: #f8fafc;
         }

         .email-container {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            overflow: hidden;
         }

         /* Header */

         .header {
            padding: 34px 40px;
            background-color: #4f46e5;
            text-align: center;
         }

         .brand-mark {
            width: 48px;
            height: 48px;
            margin: 0 auto 14px;
            border-radius: 12px;
            background-color: #ffffff;
            color: #4f46e5;
            font-size: 24px;
            font-weight: 800;
            line-height: 48px;
            letter-spacing: -1px;
         }

         .brand-name {
            color: #ffffff;
            font-size: 24px;
            line-height: 1.3;
            font-weight: 700;
            letter-spacing: -0.4px;
         }

         .brand-subtitle {
            margin-top: 7px;
            color: #e0e7ff;
            font-size: 13px;
            line-height: 1.5;
         }

         /* Content */

         .content {
            padding: 42px 44px 40px;
         }

         .greeting {
            color: #111827;
            font-size: 21px;
            line-height: 1.4;
            font-weight: 700;
            margin-bottom: 14px;
         }

         .message {
            color: #64748b;
            font-size: 15px;
            line-height: 1.75;
            margin-bottom: 32px;
         }

         /* OTP */

         .otp-section {
            padding: 28px 20px;
            background-color: #f8f9ff;
            border: 1px solid #e0e7ff;
            border-radius: 12px;
            text-align: center;
         }

         .otp-label {
            margin-bottom: 13px;
            color: #64748b;
            font-size: 12px;
            line-height: 1.4;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.4px;
         }

         .otp {
            display: inline-block;
            min-width: 210px;
            padding: 13px 24px;
            background-color: #ffffff;
            border: 1px solid #c7d2fe;
            border-radius: 10px;
            color: #4f46e5;
            font-size: 32px;
            line-height: 1.3;
            font-weight: 800;
            letter-spacing: 8px;
         }

         .expiration {
            margin-top: 14px;
            color: #94a3b8;
            font-size: 12px;
            line-height: 1.5;
         }

         .expiration strong {
            color: #4f46e5;
            font-weight: 700;
         }

         /* Security */

         .security-box {
            margin-top: 28px;
            padding: 16px 18px;
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
         }

         .security-title {
            margin-bottom: 6px;
            color: #334155;
            font-size: 13px;
            line-height: 1.5;
            font-weight: 700;
         }

         .security-text {
            color: #64748b;
            font-size: 12px;
            line-height: 1.65;
         }

         /* Footer */

         .footer {
            padding: 24px 30px;
            background-color: #f8fafc;
            border-top: 1px solid #eef2f7;
            text-align: center;
         }

         .footer-text {
            color: #94a3b8;
            font-size: 12px;
            line-height: 1.7;
         }

         .footer-brand {
            margin-top: 9px;
            color: #4f46e5;
            font-size: 13px;
            line-height: 1.5;
            font-weight: 700;
         }

         /* Mobile */

         @media (max-width: 480px) {
            .email-wrapper {
               padding: 24px 12px;
            }

            .header {
               padding: 30px 22px;
            }

            .content {
               padding: 32px 22px;
            }

            .brand-name {
               font-size: 22px;
            }

            .greeting {
               font-size: 19px;
            }

            .otp-section {
               padding: 24px 14px;
            }

            .otp {
               min-width: 180px;
               padding: 12px 18px;
               font-size: 27px;
               letter-spacing: 6px;
            }

            .footer {
               padding: 22px 18px;
            }
         }
      </style>
   </head>

   <body>
      <div class="email-wrapper">
         <div class="email-container">
            ```
            <!-- Header -->
            <div class="header">
               <div class="brand-mark">PP</div>

               <div class="brand-name">Power Pulse</div>

               <div class="brand-subtitle">
                  Load Shedding &amp; Power Management
               </div>
            </div>

            <!-- Main Content -->
            <div class="content">
               <div class="greeting">Hello <%= name %>,</div>

               <p class="message">
                  We received a request to verify your email address for your
                  Power Pulse account. Please use the verification code below to
                  complete your email verification.
               </p>

               <!-- OTP -->
               <div class="otp-section">
                  <div class="otp-label">Email Verification Code</div>

                  <div class="otp"><%= otp %></div>

                  <div class="expiration">
                     This verification code will expire in
                     <strong><%= expirationTime %> minutes</strong>.
                  </div>
               </div>

               <!-- Security Notice -->
               <div class="security-box">
                  <div class="security-title">
                     Keep your verification code private
                  </div>

                  <div class="security-text">
                     Never share this verification code with anyone. Power Pulse
                     will never ask you for your OTP or password.
                  </div>
               </div>
            </div>

            <!-- Footer -->
            <div class="footer">
               <div class="footer-text">
                  If you did not request this verification code, you can safely
                  ignore this email.
               </div>

               <div class="footer-brand">Power Pulse</div>
            </div>
         </div>
         ```
      </div>
   </body>
</html>

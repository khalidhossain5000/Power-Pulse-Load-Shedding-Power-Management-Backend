<!DOCTYPE html>

<html lang="en">
   <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Welcome to Power Pulse</title>

      <style>
         * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
         }

         body {
            margin: 0;
            padding: 0;
            background-color: #f8fafc;
            font-family:
               Inter,
               -apple-system,
               BlinkMacSystemFont,
               "Segoe UI",
               Arial,
               Helvetica,
               sans-serif;
            color: #111827;
         }

         .email-wrapper {
            width: 100%;
            padding: 48px 16px;
            background-color: #f8fafc;
         }

         .email-container {
            width: 100%;
            max-width: 620px;
            margin: 0 auto;
            background-color: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            overflow: hidden;
         }

         /* Header */

         .header {
            padding: 36px 40px;
            background-color: #4f46e5;
            text-align: center;
         }

         .brand-mark {
            width: 52px;
            height: 52px;
            margin: 0 auto 14px;
            background-color: #ffffff;
            border-radius: 13px;
            color: #4f46e5;
            font-size: 18px;
            font-weight: 800;
            line-height: 52px;
            letter-spacing: -0.5px;
         }

         .brand-name {
            color: #ffffff;
            font-size: 28px;
            line-height: 1.3;
            font-weight: 700;
            letter-spacing: -0.5px;
         }

         .brand-subtitle {
            margin-top: 8px;
            color: #e0e7ff;
            font-size: 13px;
            line-height: 1.6;
         }

         /* Main Content */

         .content {
            padding: 42px 44px 40px;
         }

         .greeting {
            margin: 0 0 15px;
            color: #111827;
            font-size: 22px;
            line-height: 1.4;
            font-weight: 700;
         }

         .message {
            margin: 0 0 25px;
            color: #64748b;
            font-size: 15px;
            line-height: 1.8;
         }

         .message strong {
            color: #334155;
            font-weight: 700;
         }

         /* Verification Success */

         .success-box {
            margin: 30px 0;
            padding: 25px 22px;
            background-color: #f5f7ff;
            border: 1px solid #c7d2fe;
            border-radius: 12px;
            text-align: center;
         }

         .success-mark {
            width: 48px;
            height: 48px;
            margin: 0 auto 13px;
            background-color: #4f46e5;
            border-radius: 50%;
            color: #ffffff;
            font-size: 20px;
            font-weight: 700;
            line-height: 48px;
         }

         .success-box h3 {
            margin: 0 0 8px;
            color: #3730a3;
            font-size: 17px;
            line-height: 1.5;
            font-weight: 700;
         }

         .success-box p {
            margin: 0;
            color: #6366f1;
            font-size: 13px;
            line-height: 1.7;
         }

         /* Features */

         .features-title {
            margin: 32px 0 18px;
            color: #111827;
            font-size: 18px;
            line-height: 1.5;
            font-weight: 700;
         }

         .feature {
            width: 100%;
            margin-bottom: 16px;
            padding: 16px;
            background-color: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
         }

         .feature:last-child {
            margin-bottom: 0;
         }

         .feature-label {
            margin-bottom: 5px;
            color: #334155;
            font-size: 14px;
            line-height: 1.5;
            font-weight: 700;
         }

         .feature-text {
            color: #64748b;
            font-size: 13px;
            line-height: 1.6;
         }

         /* CTA */

         .cta-wrapper {
            margin: 34px 0 8px;
            text-align: center;
         }

         .cta-button {
            display: inline-block;
            padding: 13px 27px;
            background-color: #4f46e5;
            border-radius: 9px;
            color: #ffffff !important;
            text-decoration: none;
            font-size: 14px;
            line-height: 1.5;
            font-weight: 700;
         }

         .login-note {
            margin-top: 12px;
            color: #94a3b8;
            font-size: 12px;
            line-height: 1.5;
         }

         /* Footer */

         .footer {
            padding: 25px 30px;
            background-color: #f8fafc;
            border-top: 1px solid #eef2f7;
            text-align: center;
         }

         .footer-text {
            color: #94a3b8;
            font-size: 12px;
            line-height: 1.7;
         }

         .footer-brand {
            margin-top: 8px;
            color: #4f46e5;
            font-size: 13px;
            line-height: 1.5;
            font-weight: 700;
         }

         .developer-credit {
            margin-top: 12px;
            color: #94a3b8;
            font-size: 11px;
            line-height: 1.6;
         }

         .developer-name {
            color: #64748b;
            font-weight: 600;
         }

         .copyright {
            margin-top: 5px;
            color: #cbd5e1;
            font-size: 11px;
            line-height: 1.5;
         }

         /* Responsive */

         @media only screen and (max-width: 600px) {
            .email-wrapper {
               padding: 24px 12px;
            }

            .header {
               padding: 30px 22px;
            }

            .brand-name {
               font-size: 24px;
            }

            .content {
               padding: 32px 22px;
            }

            .greeting {
               font-size: 20px;
            }

            .success-box {
               padding: 23px 17px;
            }

            .feature {
               padding: 14px;
            }

            .footer {
               padding: 23px 18px;
            }
         }
      </style>
   </head>

   <body>
      <div class="email-wrapper">
         <div class="email-container">
            ```
            <!-- Header -->
            <div class="header">
               <div class="brand-mark">PP</div>

               <div class="brand-name">Welcome to Power Pulse</div>

               <div class="brand-subtitle">
                  Load Shedding &amp; Power Management
               </div>
            </div>

            <!-- Main Content -->
            <div class="content">
               <div class="greeting">Hello, <%= name %>!</div>

               <p class="message">
                  Welcome to <strong>Power Pulse</strong> — a smarter way to
                  monitor power distribution, load shedding, outages, and
                  power-related activities.
               </p>

               <!-- Verification Success -->
               <div class="success-box">
                  <div class="success-mark">✓</div>

                  <h3>Email Successfully Verified</h3>

                  <p>
                     Your email address has been verified successfully. Your
                     Power Pulse account is now active and ready to use.
                  </p>
               </div>

               <p class="message">
                  You're all set! You can now log in to your account and start
                  using Power Pulse to stay informed about your power network
                  and important power events.
               </p>

               <!-- Features -->
               <div class="features-title">Explore Power Pulse</div>

               <div class="feature">
                  <div class="feature-label">Load Shedding Schedules</div>

                  <div class="feature-text">
                     Monitor planned load shedding schedules and stay prepared
                     for upcoming interruptions.
                  </div>
               </div>

               <div class="feature">
                  <div class="feature-label">Outage Monitoring</div>

                  <div class="feature-text">
                     Stay updated about unexpected power outages and restoration
                     activities.
                  </div>
               </div>

               <div class="feature">
                  <div class="feature-label">Power Distribution</div>

                  <div class="feature-text">
                     Access information across zones, substations, feeders, and
                     service areas.
                  </div>
               </div>

               <div class="feature">
                  <div class="feature-label">Important Notifications</div>

                  <div class="feature-text">
                     Receive timely updates about outages, load shedding, and
                     other important power events.
                  </div>
               </div>

               <!-- CTA -->
               <div class="cta-wrapper">
                  <a href="YOUR_FRONTEND_URL/login" class="cta-button">
                     Login to Power Pulse
                  </a>

                  <div class="login-note">
                     Your account is verified and ready to use.
                  </div>
               </div>
            </div>

            <!-- Footer -->
            <div class="footer">
               <div class="footer-text">
                  Thank you for joining
                  <span class="footer-brand">Power Pulse</span>.
               </div>

               <div class="footer-text">
                  This is an automated email. Please do not reply to this
                  message.
               </div>

               <div class="developer-credit">
                  Developed by
                  <span class="developer-name"> Md Khalid Hossain </span>
               </div>

               <div class="copyright">
                  &copy; <%= new Date().getFullYear() %> Power Pulse. All rights
                  reserved.
               </div>
            </div>
         </div>
         ```
      </div>
   </body>
</html>
